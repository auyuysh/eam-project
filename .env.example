# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Flask Secret Key (generate a strong random key for production)
FLASK_SECRET_KEY=

# Authentication Settings
MFA_ENABLED=True
OTP_EXPIRY_MINUTES=10

# Authentication Provider: LDAP or LOCAL
AUTH_PROVIDER=LDAP

# LDAP Settings
LDAP_SERVER=ldap://127.0.0.1
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=local
LDAP_ADMIN_DN=cn=admin,dc=example,dc=local
LDAP_ADMIN_PASSWORD=

# Super Admin Bootstrap
SUPER_ADMIN_EMAIL=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eam_db
DB_USER=postgres
DB_PASSWORD=
